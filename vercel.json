{
  "version": 2,
  "routes": [
    { "src": "/api/agent", "dest": "/api/agent.js" },
    { "src": "/api/github", "dest": "/api/github.js" },
    { "src": "/api/athelgard", "dest": "/api/athelgard/index.ts" },
    { "src": "/api/athelgard/(.*)", "dest": "/api/athelgard/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

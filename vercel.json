{
  "version": 2,
  "name": "athelgard-site",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "memory": 3008,
        "maxDuration": 60
      }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "memory": 3008,
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/", "destination": "/frontend/index.html" }
  ]
}

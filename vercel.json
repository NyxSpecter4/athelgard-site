{
  "version": 2,
  "functions": {
    "api/health/index.ts": { "runtime": "@vercel/node" },
    "api/athelgard/index.ts": { "runtime": "@vercel/node" }
  },
  "routes": [
    { "src": "/api/(agent|github|bountywarz|health)(/.*)?", "dest": "/api/health/index.ts?path=$1" },
    { "src": "/api/athelgard", "dest": "/api/athelgard/index.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}

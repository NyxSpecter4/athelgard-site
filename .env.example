# Athelgard — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ─── GitHub OAuth App ───────────────────────────────────────────
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set callback URL to: https://<your-vercel-domain>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Vercel OAuth ───────────────────────────────────────────────
# Create a Vercel OAuth integration at https://vercel.com/account/tokens
# (OAuth integrations: https://vercel.com/docs/integrations/create-integration)
# Set redirect URI to: https://<your-vercel-domain>/api/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# Optional — defaults to https://<host>/api/vercel/callback
VERCEL_REDIRECT_URI=

# ─── AI API Keys ────────────────────────────────────────────────
# These are set directly in Vercel's dashboard (not needed for local dev unless
# you want the AI chat to work locally).
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Kimi / Moonshot: https://platform.moonshot.cn/
KIMI_API_KEY=

# ─── Runtime ────────────────────────────────────────────────────
# Set automatically by Vercel — only needed locally
NODE_ENV=development

# Athelgard Site — Environment Variables
# Copy this file to .env.local and fill in your keys

# === REQUIRED ===

# GitHub OAuth (for repo browsing)
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_SESSION_SECRET=random_string_for_session_encryption

# Supabase (database + auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_REST_URL=https://your-project.supabase.co/rest/v1

# === LLM PROVIDERS (at least 1 required) ===

# DeepSeek — primary model (cheap off-peak)
DEEPSEEK_API_KEY=your_deepseek_key

# Kimi — fallback during peak hours (9AM-9PM PST)
KIMI_API_KEY=your_kimi_key

# === OPTIONAL ===

# Bountywarz integration (soft-fails if unset)
BOUNTYWARZ_EVE_URL=https://bountywarz.com
ATHELGARD_EVE_BRIDGE_SECRET=shared_secret_for_eve_bridge

# Voice upstream (for Twilio/proxy)
VOICE_UPSTREAM=https://bountywarz.com/api/ka-voice

{
  "name": "athelgard",
  "version": "2.0.0",
  "description": "Athelgard — Your AI wingmate for ethical bounty hunting. CLI agent with owl personality.",
  "main": "cli/athelgard.js",
  "bin": {
    "athelgard": "./cli/athelgard.js"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "echo 'No build needed - JS files are ready'",
